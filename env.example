# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_token_here

# Discord Bot Token (get from Discord Developer Portal)
DISCORD_TOKEN=your_discord_token_here

# Primary LLM API key used by llm.api_key_env
LLM_API_KEY=your_primary_llm_api_key_here

# Optional fallback LLM API key used by llm.fallback.api_key_env
LLM_FALLBACK_API_KEY=your_fallback_llm_api_key_here

# Optional backward-compatible aliases for older local setups
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
